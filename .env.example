# LLM Configuration
LEARNING_LLM_PROVIDER=mock # options: mock | local | deepseek
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b # Ollama tag; LM Studio: LOCAL_LLM_BASE_URL=http://localhost:1234/v1 + LOCAL_LLM_MODEL=qwen3.5-4b
LOCAL_LLM_TIMEOUT_MS=90000
LOCAL_LLM_REASONING_EFFORT=none # turns off hidden thinking; "off" omits the field
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Persistence & Database Configuration
LEARNING_PERSISTENCE=memory # options: memory | supabase; production student use requires Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_NAME=Learning OS

# Local presentation gate (server-only; keep the password and session secret out of browser code)
DEMO_MODE_ENABLED=false
DEMO_MODE_PASSWORD=replace-with-a-local-demo-password
DEMO_MODE_SESSION_SECRET=replace-with-a-random-server-secret
# Synthetic demo only when LEARNING_PERSISTENCE=memory in production.
LEARNING_ALLOW_MEMORY_PRODUCTION=false

# Research export (LOS-015)
# Server-only secret for one-way participant keys (HMAC). Required in Supabase mode, min 16 chars.
# Keep it stable for the whole study, or keys will change between exports.
RESEARCH_KEY_SECRET=
# Must match consent_records.purpose for guardian consent rows.
RESEARCH_CONSENT_PURPOSE=classroom_action_research

# Teacher dashboard gate (server-only): set a password to require it for /teacher and /api/teacher.
TEACHER_DASHBOARD_PASSWORD=
# Random 32+ char secret that signs the teacher cookie; rotate to sign everyone out.
TEACHER_SESSION_SECRET=
